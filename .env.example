# 复制为 .env 后填入真实值：cp .env.example .env
# .env 已在 .gitignore 中，不会被提交

# --- 必填：模型供应商（默认硅基流动）---
SILICONFLOW_API_KEY=sk-your-key-here
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# --- 可选：换模型 / 换供应商时改这里，不用动代码 ---
MODEL_NAME=Qwen/Qwen2.5-7B-Instruct
EMBEDDING_MODEL=BAAI/bge-m3

# --- 可选：外部调用超时（秒）---
LLM_TIMEOUT_SEC=60
LLM_MAX_RETRIES=2

# --- 服务端鉴权 ---
# 留空 = 只接受本机请求（127.0.0.1），外部来源一律 401。
# 部署到网络必须设置，多个 key 用英文逗号分隔。
AUTOFIX_API_KEYS=dev-local-key

# CLI / pre-commit 钩子访问服务时用（与服务端某个 key 保持一致）
AUTOFIX_API_KEY=dev-local-key

# --- 限流与配额（进程内计数，单机有效）---
AUTOFIX_RATE_LIMIT_PER_MIN=10
AUTOFIX_DAILY_QUOTA=200

# --- 可选：Langfuse 全链路追踪，不填则自动跳过 ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
